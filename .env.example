ANTHROPIC_API_KEY=
# BE_main과 AI 서버에만 동일하게 설정. 프론트에 전달하지 않는다.
AI_INTERNAL_TOKEN=
MODEL_NAME=claude-sonnet-5
# 프로세스 수명 동안 허용할 웹 검색 횟수. 1회당 $0.01이므로 300이면 약 $3이다.
SEARCH_LIMIT=300
# 쉼표로 구분한 공식 사업자 도메인만 입력한다. 스킴과 경로는 넣지 않는다.
CATALOG_ALLOWED_DOMAINS=tworld.co.kr,kt.com,lguplus.com,netflix.com,disneyplus.com,tving.com,wavve.com,watcha.com,youtube.com
LOG_LEVEL=INFO
